{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "data", "message"],
  "properties": {
    "success": {"type": "boolean"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startTime", "endTime", "availableCapacity"],
        "properties": {
          "startTime": {"type": "string", "format": "time"},
          "endTime": {"type": "string", "format": "time"},
          "availableCapacity": {"type": "integer", "minimum": 0}
        }
      }
    },
    "message": {"type": "string"},
    "therapists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["therapistId", "name", "gender"],
        "properties": {
          "therapistId": {"type": "integer"},
          "name": {"type": "string"},
          "gender": {"type": "string", "enum": ["Male", "Female"]}
        }
      }
    }
  }
}