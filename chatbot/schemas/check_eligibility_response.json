{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "data", "message"],
  "properties": {
    "success": {"type": "boolean"},
    "data": {
      "type": "object",
      "required": ["isEligible", "isBlocked"],
      "properties": {
        "isEligible": {"type": "boolean"},
        "isBlocked": {"type": "boolean"}
      }
    },
    "message": {"type": "string"}
  }
}
