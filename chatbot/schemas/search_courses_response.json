{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "data", "message"],
  "properties": {
    "success": {"type": "boolean"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["courseId", "courseName", "durations", "courseType"],
        "properties": {
          "courseId": {"type": "integer"},
          "courseName": {"type": "string"},
          "durations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["duration", "price"], "properties": {"duration": {"type": "integer", "minimum": 1}, "price": {"type": "integer", "minimum": 0}}}},
          "courseType": {"type": "string", "enum": ["main", "addon"]},
          "status": {"type": "string", "enum": ["active", "inactive"]}
        }
      }
    },
    "message": {"type": "string"}
  }
}
